{
  "name": "bayanflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.js",
    "api": "node --env-file-if-exists=.env api/server.js",
    "db:setup": "node --env-file-if-exists=.env api/setup.js",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.1.0",
    "next": "^16.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.40.0"
  }
}
